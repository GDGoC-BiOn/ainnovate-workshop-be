# arahin-mini environment variables
# Copy this file to .env and adjust the values for your machine.
#
#   cp .env.example .env
#
# make run          -> reads .env automatically
# plain go run      -> export the variables yourself or use `set -a; source .env`

# HTTP server address
HTTP_ADDR=:8080

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arahin_mini?sslmode=disable

# AI stub behaviour (workshop only — no API key needed)
# Delay in milliseconds simulated for each AI call.
AI_STUB_DELAY_MS=400
# Probability in [0.0, 1.0] that a generation fails (demo the "failed" status).
# 0.0 = never fails.
AI_STUB_FAIL_RATE=0.0